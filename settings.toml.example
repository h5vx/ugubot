# Copy to settings.toml. Secrets can go to .secrets.toml (same format) or to
# environment variables: UGUBOT_<SECTION>__<KEY>, e.g. UGUBOT_XMPP__PASSWORD.

# JIDs allowed to use ~block / ~unblock / ~blocklist in private chat with the bot
admin_jids = ["example@example.com"]

[xmpp]
jid = "example@example.com"
password = "your-password"
ssl_verify = true
# resource = "ugubot"
# Connect to this host:port instead of looking up SRV records
# host = "xmpp.example.com:5222"

[xmpp.subscribes]
auto_approve = true

# Answer to XEP-0092 version queries with this
[xmpp.iq.version]
name = "mcabber"
version = "1.1.2"
# os = "TempleOS"

# ROOMS TO JOIN
# Create a section [xmpp.rooms.<any-name>] for each room:
#
# [xmpp.rooms.test]
# join = true
# jid = "test@conference.example.com"
# nick = "bot"
# password = "room-password"

[openai]
enabled = false
api_key = "your-api-key"
# Any OpenAI-compatible API
# base_url = "https://api.openai.com/v1/"
model = "gpt-4o-mini"
# "~4 <text>" uses the secondary model
model_secondary_command = "4"
model_secondary = "gpt-4o"
# In rooms the bot answers messages starting with this nick
user_nick = "bot"
command_prefix = "~"
# Context window of the model and how much of it is kept for the answer
max_tokens = 16384
tokens_reserved_for_response = 1024

# USD per 1K tokens by model name prefix, for ~usage and ~$.
# The longest matching prefix wins; defaults exist for gpt-3.5, gpt-4, gpt-4o, gpt-4o-mini.
# [openai.prices."gpt-4.1"]
# input = 0.002
# output = 0.008

# Prompts added with a command, e.g. "~dan <text>"
# [openai.prompt.dan]
# command = "dan"
# text = """..."""

[webui]
listen = "localhost"
port = 8000
debug = false
# sha512 hex digests of passwords: printf 'my password' | sha512sum
# passwords_sha512 = ["", ""]

# Auth cookie is signed with this key
# signing_key = ""

# Period after which the auth cookie expires: <number>s/m/h/d/w.
# Empty string disables expiration.
auth_expiration = "1w"

[database]
# Only PostgreSQL is supported. Tables of the Python version are imported on the first start.
url = "postgres://ugubot:password@localhost:5432/ugubot"
# The old style also works:
# provider = "postgres"
# user = ""
# password = ""
# host = "localhost"
# port = 5432
# database = "ugubot"

[nats]
# NATS server with JetStream. "embedded" runs one inside `ugubot all`.
url = "embedded"
# Where the embedded server keeps its data
store_dir = "./nats-data"

[log]
level = "info"   # debug | info | warn | error
format = "text"  # text | json
